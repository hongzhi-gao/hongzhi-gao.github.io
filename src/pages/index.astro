---
import Base from '../layouts/Base.astro';
import TopologyHero from '../components/TopologyHero.astro';
import ArchitecturePreview from '../components/ArchitecturePreview.astro';
import profile from '../../config/profile.json';
import { featuredContributions } from '../architecture-ir/contributions';
import { projects } from '../architecture-ir/data';
import '../visual/landing.css';
import '../gaming/gallery.css';
import GamingImage from '../components/GamingImage.astro';
import { galleryPath, heroScene } from '../gaming/data';

const descriptions: Record<string,string>={
  'iotdb-tsfile':'Time-series ingestion, consensus replication and the file format that stores it.',
  'mooncake-store':'Shared object replicas for distributed KV cache, from write authorization to lease-aware cleanup.'
};
---
<Base title="Open Source Engineering" home>
  <section class="atlas-hero shell" id="about" aria-labelledby="atlas-title">
    <div class="atlas-intro">
      <h1 id="atlas-title">{profile.name}</h1>
      <div class="atlas-identity">
        <span lang="zh-Hans">{profile.nameZh}</span>
        <span>{profile.role}</span>
      </div>
      <p class="atlas-expertise">Distributed storage, database kernels and KV cache infrastructure.</p>
      <p class="atlas-education">{profile.education}</p>
      <div class="atlas-contact">
        {profile.verified && <a class="holo-button" data-magnetic href={`https://github.com/${profile.github}`}>GitHub profile</a>}
        <a class="atlas-email" href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </div>
    <div class="atlas-topology"><TopologyHero /></div>
  </section>
  <section class="atlas-projects shell" id="projects" aria-labelledby="atlas-projects-title">
    <div class="atlas-section-heading">
      <h2 id="atlas-projects-title">Open source projects</h2>
    </div>
    <div class="atlas-projects-grid">
      {projects.map(project=>{
        const path=`/projects/${project.id}/`;
        const contributions=featuredContributions(project);
        return <article class="atlas-entry" id={project.id} data-atlas-reveal>
          <a class="atlas-entry-visual" href={path} aria-label={`Explore ${project.name}`} style={`--atlas-transition:atlas-${project.id}`}>
            <ArchitecturePreview projectId={project.id}/>
          </a>
          <div class="atlas-entry-content">
            <h3><a href={path}>{project.name}</a></h3>
            <p>{descriptions[project.id]??project.description}</p>
            {contributions.length>0&&<ul class="atlas-entry-proof" aria-label="Selected contributions">
              {contributions.map(entry=><li><a href={`https://github.com/${entry.repository}/pull/${entry.number}`}><span>#{entry.number}</span> <span class="contribution-title">{entry.title}</span><small>{entry.status}</small></a></li>)}
            </ul>}
            <a class="holo-button holo-button-quiet" data-magnetic href={path}>Explore architecture</a>
          </div>
        </article>;
      })}
    </div>
  </section>
  <section class="gaming-home shell" aria-labelledby="gaming-home-title">
    <a href={galleryPath}>
      <div>
        <p class="gaming-section-name">Beyond Code</p>
        <h2 id="gaming-home-title">Gaming Worlds <span aria-hidden="true">↗</span></h2>
        <p>Some worlds are worth getting lost in.</p>
      </div>
      <GamingImage scene={heroScene} />
    </a>
  </section>
</Base>

<script>
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
    const observer=new IntersectionObserver(items=>{
      for(const item of items){
        if(!item.isIntersecting)continue;
        item.target.classList.add('is-revealed');
        observer.unobserve(item.target);
      }
    },{threshold:.12});
    for(const entry of document.querySelectorAll('[data-atlas-reveal]'))observer.observe(entry);
  }
</script>
