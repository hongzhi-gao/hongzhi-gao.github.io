---
import Base from '../layouts/Base.astro';
import ProjectWorkbench from '../components/ProjectWorkbench.astro';
import profile from '../../config/profile.json';
import { featuredContributions, contributionEntries, publicActivity } from '../architecture-ir/contributions';
import { projects } from '../architecture-ir/data';
import type { Project } from '../architecture-ir/schema';
import '../workbench.css';

function selectTabs(project:Project){
  if(project.id==='iotdb-tsfile')return [
    ['storage-engine','Storage Engine'],['iotconsensus-v1','IoTConsensus V1'],['tsfile','TsFile Format'],
  ].map(([id,label])=>({id,label,scenarios:project.modules.find(module=>module.id===id)!.scenarios}));
  if(project.id==='mooncake-store'){
    const variants=project.modules.find(module=>module.id==='object-replica')!.scenarios;
    return [{id:'object-replica',label:'Object Storage Replica',scenarios:['object-replica-sync',...variants.filter(id=>id!=='object-replica-sync')]}];
  }
  return project.modules.map(module=>({id:module.id,label:module.title,scenarios:module.scenarios}));
}
type Pull = {repo:string; number:number; title:string; status:string; role:string};
function pullRequests(project:Project){
  const top=featuredContributions(project);
  const featured=new Set(top.map(item=>item.id));
  const curated=top.concat(contributionEntries(project).filter(item=>!featured.has(item.id)));
  const entries = new Map<string,Pull>(curated.map(item=>[`${item.repository}:${item.number}`,{
    repo:item.repository,number:item.number,title:item.title,status:item.status,role:item.role
  }]));
  const activity=publicActivity.filter(item=>project.repos.includes(item.repo)).sort((first,second)=>
    Number(first.role==='reviewer')-Number(second.role==='reviewer') || second.date.localeCompare(first.date)
  );
  for(const item of activity){
    const number=Number(item.url.match(/\/pull\/(\d+)(?:[/?#]|$)/)?.[1]);
    const key=`${item.repo}:${number}`;
    if(!number||entries.has(key))continue;
    entries.set(key,{repo:item.repo,number,title:item.title,status:item.status,role:item.role});
  }
  return [...entries.values()];
}
const slogans: Record<string,string>={
  'iotdb-tsfile':'Time-series ingestion, replication and file layout.',
  'mooncake-store':'Shared object replicas, from write authorization to lease-aware cleanup.'
};
---
<Base title="Open Source Engineering" workbench>
<section class="identity" id="about" aria-labelledby="identity-title">
  <div class="shell identity-inner">
    <div>
      <h1 id="identity-title">{profile.name}<span lang="zh-Hans">{profile.nameZh}</span></h1>
      <p class="identity-credentials">{profile.role}<span aria-hidden="true"></span>{profile.education}</p>
    </div>
    <div class="identity-details">
      <p>Distributed storage, database kernels and KV cache infrastructure.</p>
      <div class="identity-links">
        {profile.verified && <a href={`https://github.com/${profile.github}`}>GitHub profile</a>}
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
      </div>
    </div>
  </div>
</section>
{projects.map(project => {
  const entries=pullRequests(project);
  const visible=entries.slice(0,Math.max(3,project.contributions.length));
  const extra=entries.slice(visible.length);
  return <section class="shell workbench-project" id={project.id} aria-labelledby={`${project.id}-title`} style={`--workbench-accent:${project.accent}`}>
    <div class="workbench-heading">
      <div>
        <h2 id={`${project.id}-title`}>{project.name}</h2>
        <p>{slogans[project.id]??project.description}</p>
      </div>
      <div class="upstream-links" aria-label="Upstream repositories">{project.repos.map(repo=><a href={`https://github.com/${repo}`}>{repo}</a>)}</div>
    </div>
    <ProjectWorkbench project={project} tabs={selectTabs(project)} />
    {entries.length>0 && <div class="project-prs">
      <div class="project-prs-heading"><h3>Pull requests</h3><span>{entries.length} linked to GitHub</span></div>
      <ul class="project-pr-list">
        {visible.map(item=><li><a href={`https://github.com/${item.repo}/pull/${item.number}`}><span class="pull-number">#{item.number}</span><span>{item.title}</span><span class:list={['pull-state',item.status]}>{item.role==='reviewer'?'Reviewed':item.status}</span></a></li>)}
      </ul>
      {extra.length>0 && <details class="more-prs"><summary>{extra.length} more pull requests</summary><ul class="project-pr-list">
        {extra.map(item=><li><a href={`https://github.com/${item.repo}/pull/${item.number}`}><span class="pull-number">#{item.number}</span><span>{item.title}</span><span class:list={['pull-state',item.status]}>{item.role==='reviewer'?'Reviewed':item.status}</span></a></li>)}
      </ul></details>}
    </div>}
  </section>;
})}
</Base>
