---
import Base from '../../layouts/Base.astro';
import {contributionEntries,moduleActivity} from '../../architecture-ir/contributions';
import {projects} from '../../architecture-ir/data';
import Explorer from '../../components/Explorer.astro';
export function getStaticPaths(){return projects.map(project=>({params:{project:project.id},props:{project}}))}
const {project}=Astro.props;
const overview=project.scenarios[0];
const contributions=contributionEntries(project);
---
<Base title={project.name} description={project.description}>
  <div class="shell"><nav aria-label="Breadcrumb" class="breadcrumbs"><a href="/">Home</a> / <a href="/#projects">Projects</a> / <span>{project.name}</span></nav></div>
  <section class="shell page-intro" style={`--mint:${project.accent}`}><p class="eyebrow">{project.domain}</p><h1>{project.name}</h1><p>{project.description}</p><div class="actions">{project.repos.map(repo=><a class="button soft" href={`https://github.com/${repo}`}>{repo}</a>)}<a class="button soft" href={`/evolution/#${project.id}`}>Architecture evolution</a></div></section>
  <div class="shell expo-wrap"><Explorer project={project} scenario={overview} /></div>
  <section class="shell inner-content"><h2>Modules</h2><div class="module-list">{project.modules.map(module=><article class="module-row"><div><h3>{module.title}</h3>{moduleActivity(project,module.id).length>0&&<a class="module-activity" href={`/contributions/#activity-${module.id}`}>{moduleActivity(project,module.id).length} matched contributions</a>}</div><p>{module.description}</p><ul>{module.scenarios.map(id=><li><a href={`/lab/${id}/`}>{project.scenarios.find(s=>s.id===id)?.title}</a></li>)}</ul></article>)}</div>
    <h2>My contributions</h2><div class="contribution-list">{contributions.map(item=><article class="contribution-row"><p class="row-meta">{item.date}<small>{item.role} · {item.module.replaceAll('-',' ')}</small></p><div><h3>{item.title}</h3><p>{item.problem} {item.design}</p></div><div class="row-links"><span class:list={['status',item.status]}>{item.status}</span><a href={`/lab/${item.scenario}/`}>Replay</a><a href={`https://github.com/${item.repository}/pull/${item.number}`}>PR #{item.number}</a></div></article>)}</div>
  </section>
</Base>
