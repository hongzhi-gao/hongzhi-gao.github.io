---
import Base from '../../layouts/Base.astro';
import ArchitectureCanvas from '../../components/ArchitectureCanvas.astro';
import { graphFor } from '../../structure/data';
import { projects } from '../../architecture-ir/data';
export function getStaticPaths() {
  return projects.filter(project=>graphFor(project.id)).map(project=>({params:{project:project.id},props:{project,graph:graphFor(project.id)!}}));
}
const {project,graph}=Astro.props;
---
<Base title={project.name} description={graph.overview}>
  <section class="source-project">
    <header class="source-project-head">
      <div><h1>{project.name}</h1><p>{graph.overview}</p></div>
      <div class="project-repos" aria-label="Upstream repositories">{project.repos.map(repo=><a href={`https://github.com/${repo}`}>{repo} <span aria-hidden="true">↗</span></a>)}</div>
    </header>
    <ArchitectureCanvas graph={graph} project={project} />
  </section>
</Base>
