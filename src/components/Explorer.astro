---
import type { Project, Scenario } from '../architecture-ir/schema';
import { sourceUrl } from '../architecture-ir/data';
import { stepDuration } from '../engine/replay';
const {project, scenario} = Astro.props as {project:Project,scenario:Scenario};
const version = project.versions.find(v=>v.id===scenario.version)!;
const comparison = version.compareWith ?? project.versions.find(v=>v.compareWith===version.id)?.id;
const links = Object.fromEntries(project.evidence.map(source => [source.id,{label:source.label,href:sourceUrl(source)}]));
const entry = scenario.contribution && project.contributions.find(item=>item.id===scenario.contribution);
const labels = {source:'Source-based walkthrough',teaching:'Teaching scenario',trace:'Runtime trace'};
const states = {upstream:'Upstream / merged',proposal:'Open proposal',historical:'Historical baseline'};
---
<architecture-explorer class="explorer" style={`--exhibit:${project.accent}`} data-exhibit={scenario.id}>
<script type="application/json" data-ir set:html={JSON.stringify({scenario, links, accent:project.accent}).replaceAll('<','\\u003c')}></script>
<div class="exhibit-bar">
  <div><span class="signal"></span> {labels[scenario.category]} <span class:list={['status',scenario.status==='upstream'&&'merged']}>{states[scenario.status]}</span></div>
  <div><a class="mono" href={`https://github.com/${version.repo}/commit/${version.sha}`} title={version.sha}>{version.repo} · {version.sha.slice(0,9)}</a>{comparison && <a class="compare" href={`/lab/${comparison}/`}>Compare {scenario.status==='historical' ? 'after' : 'before'}</a>}</div>
</div>
<div class="explorer-grid">
  <div class="scene-side">
    <div class="scene-stage" data-stage>
      <canvas aria-hidden="true"></canvas>
      <div class="scene-floor"></div>
      <svg class="fallback-paths" aria-hidden="true"><g data-links></g><circle data-packet r="4" visibility="hidden" /></svg>
      <div class="stage-status"><span class="signal"></span><span data-mode>2D overview</span></div>
      <div class="node-layer" data-nodes>
        {scenario.components.map(component=><button type="button" data-node={component.id} data-kind={component.kind} aria-pressed="false"><span class="node-symbol"></span><span>{component.label}</span><small data-node-state>Ready</small></button>)}
      </div>
    </div>
    <div class="controls" role="group" aria-label="Playback">
      <button type="button" data-previous aria-label="Previous step">−1</button>
      <button class="play-control" type="button" data-play>Play</button>
      <button type="button" data-next aria-label="Next step">+1</button>
      <input type="range" data-scrub min="0" max={scenario.timeline.length*stepDuration} step="1" value="0" aria-label="Timeline position" />
      <label><span class="sr-only">Playback speed</span><select data-speed aria-label="Playback speed"><option value=".5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option></select></label>
      <label><input type="checkbox" data-loop /> Loop</label>
      <label><input type="checkbox" data-focus checked /> Focus</label>
      <button type="button" data-view aria-pressed="false">3D</button>
    </div>
  </div>
  <aside class="inspector">
    <div class="inspector-heading"><span class="eyebrow">RUN SEQUENCE</span><span data-count>01 / {String(scenario.timeline.length).padStart(2,'0')}</span></div>
    <h3 data-event-title>{scenario.timeline[0].label}</h3><p data-event-detail>{scenario.timeline[0].detail}</p>
    <div class="inspector-sources" data-event-sources>{scenario.timeline[0].evidence.map(id=><a href={links[id].href}>{links[id].label}</a>)}</div>
    <div class="node-inspector">
      <p class="eyebrow" data-node-level>COMPONENTS</p><h4 data-node-title>Pick a component</h4><p data-node-detail>Inspect its state, data structures and source.</p>
      <div class="inspector-sources" data-node-sources></div><a class="compare" data-node-jump hidden>Open module</a>
      {entry && <p class="attribution">Contribution · {entry.role} · <a href={`https://github.com/${entry.repository}/pull/${entry.number}`}>PR #{entry.number}</a></p>}
    </div>
  </aside>
</div>
<div class="step-list" aria-label="Timeline steps">{scenario.timeline.map((item,index)=><button type="button" data-step={index} aria-current={index===0?'step':undefined}><span>{String(index+1).padStart(2,'0')}</span>{item.label}</button>)}</div>
<noscript><ol>{scenario.timeline.map(event=><li><strong>{event.label}</strong> {event.detail}</li>)}</ol></noscript>
</architecture-explorer>
<script>import '../engine/explorer';</script>
