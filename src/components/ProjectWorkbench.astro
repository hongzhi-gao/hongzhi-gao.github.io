---
import Explorer from './Explorer.astro';
import type { Project } from '../architecture-ir/schema';
type Tab = {id:string;label:string;scenarios:string[]};
const {project,tabs} = Astro.props as {project:Project,tabs:Tab[]};
const first = project.scenarios.find(scene => scene.id === tabs[0].scenarios[0])!;
const scenes = tabs.flatMap(tab => tab.scenarios.map(id => project.scenarios.find(scene => scene.id === id)!));
const inline = Object.fromEntries(scenes.map(scene => [scene.id,`#${project.id}:${scene.id}`]));
---
<project-workbench class="workbench" data-project={project.id} style={`--workbench-accent:${project.accent}`}>
  <script type="application/json" data-workbench-config set:html={JSON.stringify(tabs).replaceAll('<','\\u003c')}></script>
  <div class="workbench-bar">
    <div class="workbench-tabs" role="tablist" aria-label={`${project.short} modules`}>
      {tabs.map((tab,index) => <button id={`${project.id}-${tab.id}`} type="button" role="tab" aria-controls={`${project.id}-stage`} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-module={tab.id}>{tab.label}</button>)}
    </div>
    <label class="workbench-scenario" hidden={tabs[0].scenarios.length<2}>
      <span>Scenario</span>
      <select data-scenario-picker aria-label="Execution scenario">
        {tabs[0].scenarios.map(id => <option value={id}>{scenes.find(scene=>scene.id===id)?.title}</option>)}
      </select>
    </label>
  </div>
  <div id={`${project.id}-stage`} role="tabpanel" aria-labelledby={`${project.id}-${tabs[0].id}`} data-workbench-panel>
    <Explorer project={project} scenario={first} inline={inline} immersive />
  </div>
  {scenes.map(scene => <template data-scene={scene.id} data-title={scene.title}><Explorer project={project} scenario={scene} inline={inline} immersive /></template>)}
</project-workbench>
<script>
  import '../engine/workbench';
</script>
