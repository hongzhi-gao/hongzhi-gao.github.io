---
const {home=false}=Astro.props as {home?:boolean};
---
<div class="holo-environment" data-holo-environment data-room={home?'home':'exhibit'} aria-hidden="true">
  {home && <div class="holo-ambient"><div class="holo-aurora"></div><div class="holo-grain"></div></div>}
  <canvas class="holo-canvas" data-holo-canvas></canvas>
</div>
<script>
  import { mountEnvironment } from '../visual/environment';
  const stage=document.querySelector<HTMLElement>('[data-holo-environment]');
  if(stage)mountEnvironment(stage);
</script>
