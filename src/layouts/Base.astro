---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '../style.css';
import '../visual/theme.css';
import HolographicEnvironment from '../components/HolographicEnvironment.astro';
import profile from '../../config/profile.json';
const {title, home = false, description = 'An interactive field guide to distributed storage systems and open-source engineering by Hongzhi Gao.'} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} · Hongzhi Gao</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#0A0A0B" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<link rel="canonical" href={canonical} />
<link rel="alternate" type="application/rss+xml" title="Engineering notes" href="/rss.xml" />
<link rel="icon" href="/mark.svg" type="image/svg+xml" />
</head>
<body class:list={['atlas-site',home&&'atlas-site-home']}>
<HolographicEnvironment home={home} />
<a class="skip" href="#main">Skip to content</a>
<header class="site-header"><div class="shell header-inner">
<a class="wordmark" href="/"><span class="holo-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Hongzhi Gao</span></a>
<nav aria-label="Main navigation" class="atlas-nav">
  <a href={home?'#projects':'/#projects'} aria-current={home?'page':undefined}>Projects</a>
  <a href="/projects/iotdb-tsfile/" aria-current={Astro.url.pathname.startsWith('/projects/iotdb-tsfile/')?'page':undefined}>IoTDB &amp; TsFile</a>
  <a href="/projects/mooncake-store/" aria-current={Astro.url.pathname.startsWith('/projects/mooncake-store/')?'page':undefined}>Mooncake Store</a>
</nav>
{profile.verified&&<a class="holo-button holo-button-quiet atlas-github" data-magnetic href={`https://github.com/${profile.github}`}>GitHub</a>}
</div></header>
<main id="main"><slot /></main>
<footer class="site-footer"><div class="shell footer-inner">
<div><a class="wordmark" href="/"><span class="holo-mark" aria-hidden="true"><span></span><span></span><span></span></span><span>Hongzhi Gao</span></a></div>
<div><a href="/blog/">Technical notes</a><a href={`mailto:${profile.email}`}>Apache email</a><a href="/rss.xml">RSS</a><a href={`https://github.com/${profile.github}/${profile.github}.github.io`}>Site source</a></div>
</div></footer>
</body>
</html>
